<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:dir2site.SftpSync.Ui"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="480"
        x:Class="dir2site.SftpSync.Ui.SyncPreviewView"
        x:DataType="vm:SyncPreviewViewModel"
        Width="560" Height="480" MinWidth="400" MinHeight="300" CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Review deploy">

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}"
                   FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Note}"
                   IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="Deploy" Command="{Binding ConfirmCommand}"
                    IsEnabled="{Binding CanDeploy}"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}"/>
        </StackPanel>

        <!-- Stale files are listed for information only; removing them is its own deliberate step. -->
        <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasStale}" Margin="0,8,0,0">
            <TextBlock Text="{Binding StaleHeading}" FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
        </StackPanel>

        <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Uploads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{Binding}" FontFamily="Courier New" FontSize="11"
                                       Margin="6,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
